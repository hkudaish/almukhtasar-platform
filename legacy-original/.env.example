# Public origin used for canonical URLs, feeds, and sharing
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Core services (required for the production backend phase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/almukhtasar
REDIS_URL=redis://localhost:6379
SEARCH_URL=http://localhost:7700
SEARCH_API_KEY=
S3_ENDPOINT=
S3_BUCKET=almukhtasar-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Provider adapters — select providers without changing application code
NEWS_PROVIDER=rss
NEWS_API_KEY=
AI_PROVIDER=openai
AI_API_KEY=
EMAIL_PROVIDER=
EMAIL_API_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# Social trend connectors. Each endpoint must return JSON containing an array
# (directly, or in data/items/posts/results). Records need account, text, and
# an external url; optional fields include topic, publishedAt, metrics, handle.
SOCIAL_X_API_URL=
SOCIAL_X_BEARER_TOKEN=
SOCIAL_INSTAGRAM_API_URL=
SOCIAL_INSTAGRAM_ACCESS_TOKEN=
SOCIAL_TIKTOK_API_URL=
SOCIAL_TIKTOK_ACCESS_TOKEN=
SOCIAL_SNAPCHAT_API_URL=
SOCIAL_SNAPCHAT_ACCESS_TOKEN=
SOCIAL_YOUTUBE_API_URL=
SOCIAL_YOUTUBE_ACCESS_TOKEN=
SOCIAL_CRON_SECRET=
SOCIAL_FRESHNESS_HOURS=48
RETRIEVAL_CRON_SECRET=
# Vercel Cron may use this standard name instead.
CRON_SECRET=

# Optional analytics; load only after cookie consent
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
SOCIAL_FACEBOOK_API_URL=
SOCIAL_FACEBOOK_ACCESS_TOKEN=
SOCIAL_LINKEDIN_API_URL=
SOCIAL_LINKEDIN_ACCESS_TOKEN=
SOCIAL_THREADS_API_URL=
SOCIAL_THREADS_ACCESS_TOKEN=
SOCIAL_TELEGRAM_API_URL=
SOCIAL_TELEGRAM_BOT_TOKEN=
